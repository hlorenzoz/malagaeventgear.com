{
	"$schema": "https://biomejs.dev/schemas/2.5.15/schema.json",
	"vcs": { "enabled": true, "clientKind": "git", "useIgnoreFile": true },
	"files": {
		"ignoreUnknown": true,
		"includes": [
			"src/**/*.{ts,js,mjs,svelte,css}",
			"scripts/**/*.{ts,js,mjs}",
			"tests/**/*.ts",
			"workers/**/*.ts",
			"*.{ts,js,mjs}",
			"!**/*.d.ts"
		]
	},
	"formatter": { "indentStyle": "tab", "lineWidth": 100 },
	"javascript": { "formatter": { "quoteStyle": "single", "trailingCommas": "none" } },
	"html": { "formatter": { "enabled": true, "indentScriptAndStyle": true }, "experimentalFullSupportEnabled": true },
	"css": { "formatter": { "enabled": true } },
	"linter": { "enabled": false },
	"assist": { "enabled": false }
}
