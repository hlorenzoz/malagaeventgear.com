{
	"name": "website",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "wrangler types && bun scripts/fix-types.ts && vite build",
		"preview": "wrangler pages dev .svelte-kit/cloudflare --port 4173",
		"prepare": "svelte-kit sync || echo ''",
		"check": "wrangler types && bun scripts/fix-types.ts && svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"gen": "wrangler types && bun scripts/fix-types.ts",
		"test": "vitest run",
		"test:watch": "vitest"
	},
	"dependencies": {
		"@lucide/svelte": "^1.26.0",
		"mermaid": "^11.16.0",
		"remark-gfm": "^4.0.1",
		"zod": "^3.25.76"
	},
	"devDependencies": {
		"@playwright/test": "1.60.0",
		"@sveltejs/adapter-cloudflare": "^7.2.9",
		"@sveltejs/kit": "^2.70.1",
		"@sveltejs/vite-plugin-svelte": "^7.2.0",
		"@tailwindcss/vite": "^4.3.3",
		"@types/js-yaml": "^4.0.9",
		"@types/turndown": "^5.0.6",
		"@vite-pwa/sveltekit": "^1.1.0",
		"@vitest/coverage-v8": "^4.1.10",
		"gray-matter": "^4.0.3",
		"js-yaml": "^4.3.0",
		"linkedom": "^0.18.13",
		"mdsvex": "^0.12.8",
		"playwright": "^1.62.0",
		"rehype-slug": "^6.0.0",
		"sharp": "^0.35.3",
		"svelte": "^5.56.8",
		"svelte-check": "^4.7.3",
		"tailwindcss": "^4.3.3",
		"turndown": "^7.2.4",
		"typescript": "^6.0.3",
		"unist-util-visit": "^5.1.0",
		"vite": "^8.1.5",
		"vitest": "^4.1.10",
		"wrangler": "^4.114.0"
	}
}
