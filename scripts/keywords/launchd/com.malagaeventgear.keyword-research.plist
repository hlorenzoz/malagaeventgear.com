<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Template for the daily keyword-research and content-plan agents (plan section 3 "Agente diario", "Scheduler").
  NOT installed by default. `just keywords-schedule-install` copies this file to
  ~/Library/LaunchAgents/, substituting __REPO_PATH__ (this repo's absolute path) and
  __CLAUDE_DIR__ (the directory of `which claude`) and __HOME__, then runs
  `launchctl bootstrap gui/$(id -u) ~/Library/LaunchAgents/com.malagaeventgear.keyword-research.plist`.

  Runs `just keywords-daily` (keyword research, FAQs, then the content plan). Triggers: 09:30 local time (StartCalendarInterval),
  at load and login (RunAtLoad) and every hour (StartInterval).
  Asleep vs powered off: if the Mac is ASLEEP at 09:30, launchd runs the job on wake (missed intervals coalesce into one).
  If it is POWERED OFF or nobody is logged in, that run is lost, so RunAtLoad catches up at the next login and StartInterval
  keeps retrying while the Mac is on.
  The extra triggers are free: scripts/keywords/daily-guard.ts checks the repo (is today's research batch and plan committed?),
  the hour, the network, a lock and a daily attempts cap, and exits without calling Claude when there is nothing to do.
  Several missed days run only once, for today.
-->
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>com.malagaeventgear.keyword-research</string>

	<key>WorkingDirectory</key>
	<string>__REPO_PATH__</string>

	<key>ProgramArguments</key>
	<array>
		<string>/bin/zsh</string>
		<string>-lc</string>
		<string>just keywords-daily</string>
	</array>

	<key>EnvironmentVariables</key>
	<dict>
		<key>PATH</key>
		<string>__CLAUDE_DIR__:/usr/local/bin:/opt/homebrew/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
	</dict>

	<key>StartCalendarInterval</key>
	<dict>
		<key>Hour</key>
		<integer>9</integer>
		<key>Minute</key>
		<integer>30</integer>
	</dict>

	<key>StandardOutPath</key>
	<string>__HOME__/Library/Logs/meg-keyword-research.log</string>

	<key>StandardErrorPath</key>
	<string>__HOME__/Library/Logs/meg-keyword-research.log</string>

	<key>StartInterval</key>
	<integer>3600</integer>

	<key>RunAtLoad</key>
	<true/>
</dict>
</plist>
